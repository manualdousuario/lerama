APP_NAME=Lerama
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://lerama.local
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en

DB_CONNECTION=mariadb
LERAMA_DB_HOST=db
LERAMA_DB_NAME=lerama
LERAMA_DB_USER=root
LERAMA_DB_PASS=secret
LERAMA_DB_PORT=3306

ADMIN_USERNAME=admin
ADMIN_PASSWORD=
ADMIN_EMAIL=

PROXY_URL=

FEED_MAX_PER_RUN=3
FEED_ITEM_ERROR_THRESHOLD=5
SUBSCRIBER_SHOW_POST=false
RANDOM_POST_DAYS=30
ITEMS_PER_PAGE=21
IMAGE_EXTRACT_BATCH_SIZE=50

MAIL_MAILER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_SECURE=tls
SMTP_FROM_EMAIL=lerama@lerama.local
SMTP_FROM_NAME=Lerama
